# NEVER commit the real production .env file.
FLASK_ENV=production
PUBLIC_BASE_URL=https://your-domain.example

# Required application secrets
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret

# PostgreSQL
POSTGRES_DB=partnershub
POSTGRES_USER=partnershub
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# AI providers (optional until enabled)
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=deepseek
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# WhatsApp/provider boundary
INTERAKT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=
PRASHANT_NUMBER=
PRASHANT_WHATSAPP=

# Operational ingestion limits
P13_IMPORT_MAX_BYTES=10485760
P13_IMPORT_MAX_ROWS=10000

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
LOG_LEVEL=info
